{
  "name": "@mechanica-labs/goliath",
  "version": "0.1.0",
  "description": "Hermes-native browser hands for AI agents: persistent sessions, human-like actions, and secure uploads over MCP",
  "type": "module",
  "private": false,
  "main": "server.js",
  "license": "MIT",
  "author": "Mechanica Labs",
  "homepage": "https://github.com/Mechanica-Labs/goliath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mechanica-Labs/goliath.git"
  },
  "bugs": {
    "url": "https://github.com/Mechanica-Labs/goliath/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "keywords": [
    "browser",
    "automation",
    "headless",
    "scraping",
    "goliath",
    "anti-detection",
    "ai-agent",
    "mcp",
    "hermes",
    "hermes-agent",
    "playwright",
    "firefox",
    "youtube",
    "transcript"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "plugins/",
    "plugin.js",
    "plugin.ts",
    "dist/",
    "server.js",
    "mcp/",
    "goliath.config.json",
    "openapi.json",
    "openclaw.plugin.json",
    "assets/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "DISCLOSURE",
    "!**/*.test.js",
    "!**/*.test.ts",
    "!**/*.spec.js"
  ],
  "openclaw": {
    "extensions": [
      "plugin.ts"
    ],
    "runtimeExtensions": [
      "plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.5.3"
    },
    "tools": [
      {
        "name": "goliath_create_tab",
        "description": "Open a new browser tab at a URL"
      },
      {
        "name": "goliath_snapshot",
        "description": "Get accessibility snapshot with element refs"
      },
      {
        "name": "goliath_click",
        "description": "Click an element by ref or CSS selector"
      },
      {
        "name": "goliath_type",
        "description": "Type text into an element"
      },
      {
        "name": "goliath_navigate",
        "description": "Navigate to URL or search macro"
      },
      {
        "name": "goliath_scroll",
        "description": "Scroll page up/down/left/right"
      },
      {
        "name": "goliath_hands",
        "description": "Run an ordered multi-step UI workflow in one tab"
      },
      {
        "name": "goliath_behavior",
        "description": "Get bounded behavioral timing-diversity telemetry"
      },
      {
        "name": "goliath_act",
        "description": "Press keys, hover, wait, select options, and drag elements"
      },
      {
        "name": "goliath_upload",
        "description": "Attach files from the configured upload directory"
      },
      {
        "name": "goliath_screenshot",
        "description": "Capture page screenshot"
      },
      {
        "name": "goliath_close_tab",
        "description": "Close a browser tab"
      },
      {
        "name": "goliath_evaluate",
        "description": "Execute JavaScript in a Goliath tab page context"
      },
      {
        "name": "goliath_list_tabs",
        "description": "List open tabs for a user"
      },
      {
        "name": "goliath_import_cookies",
        "description": "Import Netscape cookie file (requires GOLIATH_API_KEY)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build && npm run generate-openapi && npm test",
    "setup": "node scripts/install.js",
    "doctor": "node scripts/install.js --check",
    "install:browser": "node scripts/install.js --skip-deps",
    "start": "node bin/goliath.js serve",
    "up": "node scripts/service.js up",
    "down": "node scripts/service.js down",
    "restart": "node scripts/service.js restart",
    "status": "node scripts/service.js status",
    "logs": "node scripts/service.js logs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "benchmark:behavior": "node scripts/behavioral-gate-harness.js",
    "plugin": "node scripts/plugin.js",
    "generate-openapi": "node scripts/generate-openapi.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "node scripts/sync-version.js && node scripts/generate-openapi.js && git add goliath.config.json openclaw.plugin.json openapi.json README.md docs/HARNESS_SETUP.md",
    "fetch-bin": "node scripts/install.js --skip-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "camoufox-js": "^0.12.0",
    "express": "^4.18.2",
    "playwright-core": "^1.58.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8"
  },
  "overrides": {
    "camoufox-js": {
      "ua-parser-js": "1.0.41"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0"
  },
  "bin": {
    "goliath": "bin/goliath.js",
    "goliath-mcp": "mcp/server.mjs"
  }
}
